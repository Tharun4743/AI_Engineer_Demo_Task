# Autonomous Pipeline Environment Configuration

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///data/pipeline.db

# LLM Providers (Optional - Orchestrator utilizes heuristic/rule-based parser if unconfigured)
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# GitHub API Token (Optional, increases rate limits for GitHub stars queries)
GITHUB_TOKEN=

# Google Sheets Service Account Credentials
# Path to service account JSON key file (e.g., config/service_account.json)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Existing Google Sheet ID (Optional; if omitted, a new spreadsheet is created and shared)
GOOGLE_SHEET_ID=

# Pipeline Execution Tuning
MAX_CONCURRENT_REQUESTS=20
REQUEST_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO
